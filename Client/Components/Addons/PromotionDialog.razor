@using ChessEngine
@using ChessWebUI.Components.ChessPieces
<MudDialog>
    <TitleContent>
        Promotion
    </TitleContent>
    <DialogContent>
        <!-- TODO: Maak hier een herbruikbaar component van --->
            <MudGrid Style="height: 100%; width: 100%; display: flex; justify-content: center; align-items: center;">
                <MudItem xs="12" Style="display: flex; justify-content: center;">
                    <MudPaper Outlined="PieceSelected is 'Q' or 'q'" @onclick="() => { PieceSelected = isWhite ? 'Q' : 'q'; }" Placement="Placement.Top"  Style="width: 50%; height: 25%; margin: .2rem;">
                        <MudItem Style="display: flex; align-content: center; flex-direction: column;">
                            <Queen IsWhite="isWhite"></Queen>
                            <MudText Typo="Typo.body1" Align="Align.Center">
                                Promote to Queen
                            </MudText>
                        </MudItem>
                    </MudPaper>
                    <MudPaper Outlined="PieceSelected is 'R' or 'r'" @onclick="() => { PieceSelected =  isWhite ? 'R' : 'r';}" Placement="Placement.Top" Label="" Style="width: 50%; height: 25%; margin: .2rem;">
                        <MudItem Style="display: flex; align-content: center; flex-direction: column;">
                            <Rook IsWhite="isWhite"></Rook>
                            <MudText Typo="Typo.body1" Align="Align.Center">
                                Promote to Rook
                            </MudText>
                        </MudItem>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" Style="display: flex; justify-content: center;">
                    <MudPaper Outlined="PieceSelected is 'B' or 'b'" @onclick="() => { PieceSelected = isWhite ? 'B' : 'b'; }" Placement="Placement.Top" Style="width: 50%; height: 25%; margin: .2rem;">
                        <MudItem Style="display: flex; align-content: center; flex-direction: column;">
                            <Bishop IsWhite="isWhite"></Bishop>
                            <MudText Typo="Typo.body1" Align="Align.Center">
                                Promote to Bishop
                            </MudText>
                        </MudItem>
                    </MudPaper>
                    <MudPaper Outlined="PieceSelected is 'N' or 'n'"  @onclick="() => { PieceSelected = isWhite ? 'N' : 'n'; }" Placement="Placement.Top" Style="width: 50%; height: 25%; margin: .2rem;">
                        <MudItem Style="display: flex; align-content: center; flex-direction: column;">
                            <Knight IsWhite="isWhite"></Knight>
                            <MudText Typo="Typo.body1" Align="Align.Center">
                                Promote to Knight
                            </MudText>
                        </MudItem>
                    </MudPaper>
                </MudItem>
            </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }

    public char PieceSelected { get; set; } = 'q';

    [Parameter] public Player Player { get; set; }

    private bool isWhite => Player == Player.White;
    
    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(PieceSelected));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

}